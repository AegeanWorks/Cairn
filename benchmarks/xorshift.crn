// Serial xorshift64 chain: a latency-dependent integer loop neither optimizer may fold.
// Twin of xorshift.c and xorshift.rs; all three print the identical final state.
fn main() -> i64 {
    var state: i64 = 88172645463325252;
    var i: i64 = 0;
    while i < 200000000 {
        state = state ^ (state << 13);
        state = state ^ (state >> 7);
        state = state ^ (state << 17);
        i = i + 1;
    }
    print(state);
    return 0;
}
