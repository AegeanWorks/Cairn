// A three-argument function on the hot path: every call walks the argument-passing path
// with non-pure operands (a shift and a mask), inside a data-dependent loop. Twin of
// call_chain.c and call_chain.rs; all three print the identical total.
fn mix3(a: i64, b: i64, c: i64) -> i64 {
    var t: i64 = (a * 3) ^ (b << 2);
    if t > c {
        t = t - c;
    } else {
        t = t + c;
    }
    return t;
}
fn main() -> i64 {
    var x: i64 = 1;
    var i: i64 = 0;
    var total: i64 = 0;
    while i < 20000000 {
        x = mix3(x, i >> 2, i & 65535);
        total = total + (x & 255);
        i = i + 1;
    }
    print(total);
    return 0;
}
