// A loop whose body is mostly constant arithmetic: the optimiser folds it before code generation.
fn main() -> i64 {
    var i: i64 = 0;
    var acc: i64 = 0;
    while i < 20000000 {
        acc = acc + (2 * 3 + 4 * 5 - 6 / 2);
        acc = acc ^ (1 << 4) | 3;
        i = i + 1;
    }
    print(acc);
    return 0;
}
