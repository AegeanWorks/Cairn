// Six-argument call throughput: each iteration passes four arguments in registers and two
// through the caller's outgoing stack area — the parameter surface cost itself, with a
// multiply-accumulate body the optimizer cannot fold. The total stays below 2^57, so no
// twin overflows i64.
// Twin of many_params.c, many_params.cpp and many_params.rs; all four print the identical
// total.
fn mix(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    return a * 31 + b * 37 + c * 41 + d * 43 + e * 47 + f * 53;
}

fn main() -> i64 {
    var i: i64 = 0;
    var total: i64 = 0;
    while i < 10000000 {
        total = total + mix(i, i + 1, i + 2, i + 3, i + 4, i + 5);
        i = i + 1;
    }
    print(total);
    return 0;
}
