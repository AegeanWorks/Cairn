// Six-argument call throughput: each iteration passes four arguments in registers and two
// through the caller's outgoing stack area. The loop bound comes from argc() so no compiler
// can fold the whole program into one print (ADR-071, ADR-074); run bare, argc() is 1 and
// the bound is exactly 10,000,000. The masked product keeps the mix a live recurrence
// rather than a closed form, and the total stays below 2^57 so no twin overflows i64.
// Twin of many_params.c, many_params.cpp and many_params.rs; all four print the identical
// total.
fn mix(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64) -> i64 {
    return ((a * b) & 65535) ^ (c + d * 43 + e * 47 + f * 53);
}

fn main() -> i64 {
    var n: i64 = 10000000 + argc() - 1;
    var i: i64 = 0;
    var total: i64 = 0;
    while i < n {
        total = total + mix(i, i + 1, i + 2, i + 3, i + 4, i + 5);
        i = i + 1;
    }
    print(total);
    return 0;
}
